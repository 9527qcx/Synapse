# ============ Synapse 环境变量模板 ============
# 用法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 排除，永远不会被提交到 GitHub。
#
# 所有变量带 SYNAPSE_ 前缀；不填的用默认值，注释掉的项都用默认值。

# ---- 大模型（必填：DeepSeek API key，用于真实调用）----
SYNAPSE_DEEPSEEK_API_KEY=sk-在此粘贴你的key
# SYNAPSE_DEEPSEEK_BASE_URL=https://api.deepseek.com
# SYNAPSE_DEEPSEEK_MODEL=deepseek-chat

# ---- 本地模型（可选：Ollama 启动并拉取模型后可用）----
# SYNAPSE_OLLAMA_BASE_URL=http://localhost:11434
# SYNAPSE_OLLAMA_MODEL=qwen2.5:7b

# ---- 模型路由（按任务难度选模型，逗号分隔 = 降级链）----
# SYNAPSE_ROUTE_PLAN=deepseek,ollama,mock
# SYNAPSE_ROUTE_EXTRACT=deepseek,ollama,mock
# SYNAPSE_ROUTE_SUMMARIZER=deepseek,mock

# ---- 嵌入模型 ----
# SYNAPSE_EMBEDDER=local        # local = BGE-M3（首次运行下载 ~2.2GB）；mock = 测试嵌入
# SYNAPSE_EMBEDDER_MODEL=BAAI/bge-m3
# HF_ENDPOINT=https://hf-mirror.com   # 国内下载 HuggingFace 模型走镜像

# ---- 向量记忆（ChromaDB）----
# SYNAPSE_CHROMA_DIR=data/chroma
# SYNAPSE_DEDUP_COSINE_THRESHOLD=0.90
# SYNAPSE_DEDUP_CLAIM_OVERLAP=0.80

# ---- 短期记忆 ----
# SYNAPSE_STM_BUDGET_TOKENS=8000
# SYNAPSE_STM_KEEP_LAST_TURNS=6

# ---- 可观测（LangFuse，可选：到 langfuse.com 注册免费账号拿 key）----
# SYNAPSE_LANGFUSE_PUBLIC_KEY=pk-xxx
# SYNAPSE_LANGFUSE_SECRET_KEY=sk-xxx
# SYNAPSE_LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 工具 ----
# SYNAPSE_SEARCH_BASE_URL=http://localhost:8080   # SearXNG（docker compose 部署）

# ---- 调试 ----
# SYNAPSE_MOCK_MODE=1   # 全链路 mock，无网可跑
